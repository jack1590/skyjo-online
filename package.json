{
  "name": "skyjo-online",
  "version": "2.4.1",
  "description": "Online multiplayer card game based on Skyjo's mechanics",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "wrangler types --env-interface Env > /dev/null && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run --coverage",
    "art": "node scripts/gen-art.ts",
    "e2e": "playwright test",
    "screenshots": "SHOTS=1 playwright test --project=iphone -g screenshots",
    "preview": "vite preview",
    "build:node": "vite build --mode node --ssr src/server/node.ts --outDir dist/node",
    "start": "node dist/node/node.js",
    "shots:readme": "SHOTS=1 playwright test --project=iphone e2e/readme.spec.ts"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
