{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyjo-online",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    // API routes reach the Worker; everything else is the SPA.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  // SQLite-backed Durable Objects are what the Workers free plan offers.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": true }
}
