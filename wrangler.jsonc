{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyjo-online",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    // API routes reach the Worker; everything else is the SPA.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  // SQLite-backed Durable Objects are what the Workers free plan offers.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  // Per client IP, or IPv6 /64, a minute (room.test.ts checks these numbers). Counts are per
  // Cloudflare location and approximate. A local run at http://localhost isn't limited.
  "ratelimits": [
    // Every /api request, checked before any Durable Object is touched.
    { "name": "API_REQUESTS", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    // Each new room writes storage and sets an alarm (and also spends 3 of MESSAGES).
    { "name": "ROOM_CREATION", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Everything an IP makes us write, across its sockets and rooms (IP_MESSAGES_PER_MINUTE in
    // room.ts): 1 a message, 2 a presence check of a room it holds open, 3 a new room.
    { "name": "MESSAGES", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
